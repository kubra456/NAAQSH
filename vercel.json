{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.php"
    },
    {
      "source": "/about",
      "destination": "/about.php"
    },
    {
      "source": "/services",
      "destination": "/services.php"
    },
    {
      "source": "/contact",
      "destination": "/contact.php"
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio.php"
    },
    {
      "source": "/plan_event",
      "destination": "/plan_event.php"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/$1"
    },
    {
      "source": "/customer/(.*)",
      "destination": "/customer/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/uploads/$1"
    },
    {
      "source": "/NAAQSH/admin/(.*)",
      "destination": "/admin/$1"
    },
    {
      "source": "/NAAQSH/customer/(.*)",
      "destination": "/customer/$1"
    },
    {
      "source": "/NAAQSH/uploads/(.*)",
      "destination": "/uploads/$1"
    },
    {
      "source": "/NAAQSH/public/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/NAAQSH/(.*)",
      "destination": "/$1"
    }
  ]
}
